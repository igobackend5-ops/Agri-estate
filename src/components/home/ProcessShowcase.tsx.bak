import React, { useEffect, useRef, useState } from 'react';
import './ProcessShowcase.css';

const W = 1536;
const H = 784;
const COLS: [number, number][] = [[30, 262], [288, 519], [538, 769], [787, 1015], [1033, 1265], [1285, 1515]];
const BADGES: [number, number][] = [[80, 279], [336, 289], [594, 287], [836, 280], [1088, 285], [1333, 289]];
const TRAIL_Y = 406;
const TRAIL_X = [277, 526, 776, 1023, 1275];
const HALF = 30;

const ProcessShowcase: React.FC = () => {
  const ref = useRef<HTMLDivElement>(null);
  const [pre, setPre] = useState(true);
  useEffect(() => {
    const el = ref.current;
    if (!el || !('IntersectionObserver' in window)) { setPre(false); return; }
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { setPre(false); io.disconnect(); } }, { threshold: 0.2 });
    io.observe(el);
    return () => io.disconnect();
  }, []);

  return (
    <div className="overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <div ref={ref} className={`ps-wrap${pre ? ' ps-pre' : ''}`}>
        <img
          className="ps-img"
          src="/images/featured/process-steps-v5.webp"
          alt="Our Process — From Land Selection to Farm Development: 1 Discover Your Land, 2 Site Visit and Evaluation, 3 Documentation and Purchase Support, 4 Farm Planning and Customisation, 5 Farm Development and Setup, 6 Ongoing Support"
          width={W}
          height={H}
          loading="lazy"
        />

        {COLS.map(([x1, x2], i) => (
          <div
            key={i}
            className="ps-col"
            style={{ left: `${(x1 / W) * 100}%`, width: `${((x2 - x1) / W) * 100}%`, top: `${(262 / H) * 100}%`, height: `${(500 / H) * 100}%`, ['--i' as string]: i } as React.CSSProperties}
          />
        ))}

        {BADGES.map(([x, y], i) => (
          <span key={i} className="ps-ping" style={{ left: `${(x / W) * 100}%`, top: `${(y / H) * 100}%`, ['--i' as string]: i } as React.CSSProperties} />
        ))}

        {/* Light-trail connectors between the six steps */}
        <svg className="ps-trails" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <filter id="ps-blur" x="-50%" y="-300%" width="200%" height="700%">
              <feGaussianBlur stdDeviation="3.2" />
            </filter>
            {TRAIL_X.map((cx, i) => (
              <React.Fragment key={i}>
                <linearGradient id={`ps-base-${i}`} gradientUnits="userSpaceOnUse" x1={cx - HALF} x2={cx + HALF} y1={TRAIL_Y} y2={TRAIL_Y}>
                  <stop offset="0" stopColor="#2e9e1f" stopOpacity="0" />
                  <stop offset="0.5" stopColor="#2e9e1f" stopOpacity="0.55" />
                  <stop offset="1" stopColor="#2e9e1f" stopOpacity="0" />
                </linearGradient>
                <linearGradient id={`ps-beam-${i}`} gradientUnits="userSpaceOnUse" x1={cx - HALF} x2={cx + HALF} y1={TRAIL_Y} y2={TRAIL_Y}>
                  <stop offset="0" stopColor="#2e9e1f" />
                  <stop offset="0.6" stopColor="#9be86a" />
                  <stop offset="1" stopColor="#ffffff" />
                </linearGradient>
              </React.Fragment>
            ))}
          </defs>
          {TRAIL_X.map((cx, i) => {
            const d = `M ${cx - HALF} ${TRAIL_Y} L ${cx + HALF} ${TRAIL_Y}`;
            return (
              <g key={i} style={{ ['--i' as string]: i } as React.CSSProperties}>
                <path className="ps-trail-base" d={d} stroke={`url(#ps-base-${i})`} strokeWidth="2.2" strokeLinecap="round" fill="none" />
                <path className="ps-trail-glow" d={d} pathLength={1} stroke="#7ddc4f" strokeWidth="7" strokeLinecap="round" fill="none" filter="url(#ps-blur)" />
                <path className="ps-trail-beam" d={d} pathLength={1} stroke={`url(#ps-beam-${i})`} strokeWidth="2.6" strokeLinecap="round" fill="none" />
              </g>
            );
          })}
        </svg>
      </div>
    </div>
  );
};

export default ProcessShowcase;
