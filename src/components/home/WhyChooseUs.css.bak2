.wc-section { --wc-forest: #0b3d13; --wc-green: #2e9e1f; --wc-green-d: #1b5e20;
  position: relative; overflow: hidden; padding: 72px 0 84px; font-family: 'Jost', system-ui, sans-serif;
  background: radial-gradient(circle at 92% 8%, rgba(143,224,90,.14), transparent 40%), linear-gradient(180deg, #f3f9ee, #fbfdf9); }
.wc-inner { max-width: 1360px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); gap: 56px; align-items: center; }

/* photo */
.wc-media { position: relative; margin: 0; border-radius: 34px 34px 34px 120px; overflow: hidden; box-shadow: 0 30px 60px rgba(27,94,32,.22), 0 0 0 6px #fff; aspect-ratio: 1280 / 940; background: #dff0d4; }
.wc-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; transition: transform 1.2s cubic-bezier(.2,.8,.2,1); }
.wc-media:hover img { transform: scale(1.04); }
.wc-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 62%, rgba(6,40,14,.55)); pointer-events: none; }
.wc-caption { position: absolute; left: 24px; bottom: 22px; z-index: 2; display: flex; align-items: center; gap: 10px; color: #fff; font-style: italic; font-weight: 500; font-size: clamp(1rem, 1.7vw, 1.4rem); text-shadow: 0 2px 10px rgba(0,0,0,.45); }
.wc-caption__leaf { width: 26px; height: 26px; flex: none; }

/* heading */
.wc-eyebrow { display: inline-flex; align-items: center; gap: 12px; color: var(--wc-green-d); }
.wc-eyebrow__line { display: block; width: clamp(34px, 6vw, 80px); height: 2px; background: var(--wc-green-d); opacity: .8; }
.wc-eyebrow__text { font-weight: 600; font-size: .9rem; letter-spacing: .08em; text-transform: uppercase; }
.wc-eyebrow__leaf { width: 26px; height: 26px; }
.wc-title { margin: 16px 0 0; font-weight: 700; font-size: clamp(1.9rem, 3.6vw, 3.1rem); line-height: 1.1; letter-spacing: -.01em; color: var(--wc-forest); text-transform: none; }
.wc-title span { color: #1e8e14; }
.wc-sub { margin: 16px 0 0; max-width: 560px; font-size: clamp(1rem, 1.35vw, 1.15rem); line-height: 1.65; color: #4f6354; }

/* cards */
.wc-grid { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.wc-card { position: relative; overflow: hidden; padding: 22px 22px 22px; border-radius: 22px; background: linear-gradient(180deg, #fff, #f6fbf2); border: 1.5px solid rgba(46,158,31,.12); box-shadow: 0 10px 26px rgba(27,94,32,.08);
  transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease, border-color .35s ease; }
.wc-card::after { content: ""; position: absolute; top: -22px; right: -22px; width: 70px; height: 70px; border-radius: 0 0 0 70px; background: linear-gradient(135deg, rgba(143,224,90,.35), rgba(143,224,90,0)); }
.wc-card:hover { transform: translateY(-6px); border-color: rgba(46,158,31,.5); box-shadow: 0 22px 44px rgba(27,94,32,.16); }
.wc-card__icon { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: var(--wc-green-d); background: radial-gradient(circle at 30% 25%, #f1fbe9, #d7efc8); box-shadow: inset 0 0 0 1px rgba(46,158,31,.15), 0 6px 14px rgba(46,158,31,.15); transition: transform .35s ease; }
.wc-card:hover .wc-card__icon { transform: scale(1.1) rotate(-6deg); }
.wc-card__title { margin: 16px 0 0; font-weight: 700; font-size: 1.12rem; line-height: 1.25; color: var(--wc-forest); text-transform: none; letter-spacing: 0; }
.wc-card__rule { display: block; width: 32px; height: 2px; margin: 10px 0; background: #7bc95a; border-radius: 2px; }
.wc-card__text { margin: 0; font-size: .95rem; line-height: 1.55; color: #3f4a42; }

/* reveal */
.wc-media, .wc-eyebrow, .wc-title, .wc-sub, .wc-card { opacity: 0; transform: translateY(30px); }
.wc-section.is-in .wc-media, .wc-section.is-in .wc-eyebrow, .wc-section.is-in .wc-title, .wc-section.is-in .wc-sub { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.21,.8,.32,1), transform .8s cubic-bezier(.21,.8,.32,1); }
.wc-section.is-in .wc-eyebrow { transition-delay: .1s; } .wc-section.is-in .wc-title { transition-delay: .2s; } .wc-section.is-in .wc-sub { transition-delay: .3s; }
.wc-section.is-in .wc-card { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.21,.8,.32,1), transform .8s cubic-bezier(.21,.8,.32,1), box-shadow .35s ease, border-color .35s ease; transition-delay: calc(.35s + var(--i) * .1s); }
.wc-section.is-in .wc-card:hover { transform: translateY(-6px); transition-delay: 0s; }

/* tablet */
@media (max-width: 1100px) { .wc-inner { gap: 36px; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } .wc-card { padding: 18px; } .wc-card__text { font-size: .9rem; } }
/* mobile / small tablet: stack */
@media (max-width: 860px) {
  .wc-section { padding: 52px 0 60px; }
  .wc-inner { grid-template-columns: 1fr; gap: 32px; padding: 0 18px; }
  .wc-content { text-align: left; }
}
@media (max-width: 520px) { .wc-grid { grid-template-columns: 1fr; } .wc-media { border-radius: 26px 26px 26px 70px; } }

@media (prefers-reduced-motion: reduce) {
  .wc-media, .wc-eyebrow, .wc-title, .wc-sub, .wc-card { opacity: 1 !important; transform: none !important; transition: none !important; }
  .wc-media img, .wc-card__icon { transition: none !important; }
}
