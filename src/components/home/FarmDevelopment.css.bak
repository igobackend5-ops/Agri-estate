.fd-section { --f: #0b3d13; --g: #1e8e14; --gd: #1b5e20;
  position: relative; overflow: hidden; padding: 56px 24px 64px; font-family: 'Jost', system-ui, sans-serif;
  background: radial-gradient(circle at 0% 0%, rgba(143,224,90,.18), transparent 38%), radial-gradient(circle at 100% 100%, rgba(143,224,90,.16), transparent 38%), linear-gradient(180deg, #f1f9ec, #fbfdf9); }
.fd-head { position: relative; z-index: 1; max-width: 900px; margin: 0 auto 34px; text-align: center; }
.fd-eyebrow { display: inline-flex; align-items: center; gap: 12px; color: var(--gd); }
.fd-eyebrow__line { width: clamp(30px, 6vw, 80px); height: 2px; background: var(--gd); opacity: .8; }
.fd-eyebrow__text { font-weight: 600; font-size: .9rem; letter-spacing: .08em; text-transform: uppercase; }
.fd-eyebrow__leaf { width: 24px; height: 24px; }
.fd-title { margin: 10px 0 0; font-weight: 700; font-size: clamp(1.8rem, 3.6vw, 3rem); line-height: 1.12; letter-spacing: -.01em; color: var(--f); text-transform: none; }
.fd-title span { color: var(--g); }
.fd-sub { margin: 12px auto 0; max-width: 680px; font-size: clamp(.95rem, 1.2vw, 1.08rem); line-height: 1.6; color: #4f6354; }

.fd-main { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 28px; align-items: stretch; }
.fd-media { position: relative; margin: 0; min-height: 340px; border-radius: 34px 34px 34px 90px; overflow: hidden; background: #dff0d4; box-shadow: 0 20px 44px rgba(27,94,32,.2), 0 0 0 5px #fff; }
.fd-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.8,.2,1); }
.fd-media:hover img { transform: scale(1.04); }

.fd-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 14px; }
.fd-card { position: relative; overflow: hidden; display: flex; flex-direction: column; padding: 18px 18px 16px; border-radius: 18px; background: linear-gradient(180deg, #fff, #f6fbf2); border: 1.5px solid rgba(46,158,31,.12); box-shadow: 0 8px 20px rgba(27,94,32,.08); transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease, border-color .35s ease; }
.fd-card::after { content: ""; position: absolute; top: -20px; right: -20px; width: 60px; height: 60px; border-radius: 0 0 0 60px; background: linear-gradient(135deg, rgba(143,224,90,.35), rgba(143,224,90,0)); }
.fd-card:hover { transform: translateY(-5px); border-color: rgba(46,158,31,.5); box-shadow: 0 18px 36px rgba(27,94,32,.16); }
.fd-card__icon, .fd-cta__icon { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; color: var(--gd); background: radial-gradient(circle at 30% 25%, #f1fbe9, #cfeabb); box-shadow: inset 0 0 0 1px rgba(46,158,31,.15), 0 5px 12px rgba(46,158,31,.15); transition: transform .35s ease; }
.fd-card:hover .fd-card__icon { transform: scale(1.1) rotate(-6deg); }
.fd-card__title { margin: 12px 0 0; font-weight: 700; font-size: 1.08rem; color: var(--f); text-transform: none; letter-spacing: 0; }
.fd-card__title::after { content: ""; display: block; width: 28px; height: 2px; margin: 7px 0 6px; background: #7bc95a; border-radius: 2px; }
.fd-card__text { margin: 0 24px 0 0; font-size: .88rem; line-height: 1.5; color: #3f4a42; }
.fd-card__go { position: absolute; right: 14px; bottom: 12px; color: var(--f); transition: transform .3s ease; }
.fd-card:hover .fd-card__go { transform: translateX(4px); color: var(--g); }

.fd-cta { position: relative; z-index: 1; max-width: 1280px; margin: 24px auto 0; padding: 18px 24px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 2fr) auto; gap: 24px; align-items: center; border-radius: 22px; background: linear-gradient(100deg, #fff 40%, #eaf6e0); border: 1.5px solid rgba(46,158,31,.12); box-shadow: 0 10px 28px rgba(27,94,32,.09); }
.fd-cta__lead { display: flex; align-items: center; gap: 14px; }
.fd-cta__lead h3 { margin: 0; font-weight: 700; font-size: 1.12rem; line-height: 1.25; color: var(--f); text-transform: none; letter-spacing: 0; }
.fd-cta__lead p { margin: 4px 0 0; font-size: .86rem; line-height: 1.45; color: #4a564d; }
.fd-pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.fd-pillars li { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 2px 10px; }
.fd-pillars li + li { border-left: 1px solid rgba(46,158,31,.2); }
.fd-pillars__icon { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: var(--gd); background: radial-gradient(circle at 30% 25%, #f1fbe9, #cfeabb); margin-bottom: 6px; }
.fd-pillars b { font-size: .9rem; font-weight: 700; color: var(--f); line-height: 1.2; }
.fd-pillars li > span:last-child { margin-top: 3px; font-size: .78rem; line-height: 1.35; color: #5a685e; }
.fd-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 999px; background: var(--f); color: #fff; font-weight: 600; text-decoration: none; white-space: nowrap; box-shadow: 0 8px 18px rgba(11,61,19,.25); transition: background .25s ease, transform .25s ease; }
.fd-btn:hover { background: var(--g); transform: translateY(-2px); }
.fd-btn svg { transition: transform .25s ease; } .fd-btn:hover svg { transform: translateX(4px); }

.fd-float { position: absolute; z-index: 0; width: 44px; height: 44px; opacity: .35; pointer-events: none; animation: fd-float 7s ease-in-out infinite; }
.fd-float--a { top: 24px; left: 4%; } .fd-float--b { top: 60px; right: 5%; width: 32px; height: 32px; animation-delay: -3s; }
@keyframes fd-float { 0%,100% { transform: translateY(0) rotate(-8deg); } 50% { transform: translateY(-14px) rotate(10deg); } }

.fd-eyebrow, .fd-title, .fd-sub, .fd-media, .fd-card, .fd-cta { opacity: 0; transform: translateY(28px); }
.fd-section.is-in .fd-eyebrow, .fd-section.is-in .fd-title, .fd-section.is-in .fd-sub, .fd-section.is-in .fd-media, .fd-section.is-in .fd-cta { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.21,.8,.32,1), transform .8s cubic-bezier(.21,.8,.32,1); }
.fd-section.is-in .fd-title { transition-delay: .1s; } .fd-section.is-in .fd-sub { transition-delay: .2s; } .fd-section.is-in .fd-cta { transition-delay: .8s; }
.fd-section.is-in .fd-card { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.21,.8,.32,1), transform .8s cubic-bezier(.21,.8,.32,1), box-shadow .35s ease, border-color .35s ease; transition-delay: calc(.3s + var(--i) * .1s); }
.fd-section.is-in .fd-card:hover { transform: translateY(-5px); transition-delay: 0s; }

@media (max-width: 1100px) {
  .fd-main { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 20px; }
  .fd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .fd-cta { grid-template-columns: 1fr auto; }
  .fd-pillars { grid-column: 1 / -1; grid-row: 2; }
}
@media (max-width: 760px) {
  .fd-section { padding: 40px 16px 44px; }
  .fd-main { grid-template-columns: 1fr; gap: 18px; }
  .fd-media { min-height: 0; aspect-ratio: 4 / 3; border-radius: 26px 26px 26px 60px; }
  .fd-cta { grid-template-columns: 1fr; padding: 18px 16px; }
  .fd-pillars { grid-column: auto; grid-row: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 14px; }
  .fd-pillars li:nth-child(3) { border-left: 0; }
  .fd-btn { justify-content: center; }
}
@media (max-width: 520px) { .fd-grid { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) {
  .fd-eyebrow, .fd-title, .fd-sub, .fd-media, .fd-card, .fd-cta { opacity: 1 !important; transform: none !important; transition: none !important; }
  .fd-float { animation: none !important; } .fd-media img { transition: none !important; }
}
