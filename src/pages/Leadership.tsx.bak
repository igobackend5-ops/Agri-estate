const Card: React.FC<{ p: Person; large?: boolean }> = ({ p, large }) => (
  <article className={`group bg-white rounded-2xl border border-[#1B5E20]/10 shadow-sm hover:shadow-lg transition-shadow overflow-hidden text-center ${large ? 'w-full max-w-[300px]' : ''}`}>
    <div className="aspect-[4/5] overflow-hidden bg-[#eef5ea]">
      <img
        src={`${IMG}${p.img}`}
        alt={p.name}
        loading="lazy"
        className="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
      />
    </div>
    <div className="p-4">
      <h3 className="text-base font-semibold text-[#0f4d24] normal-case tracking-normal leading-snug">{p.name}</h3>
      <p className="mt-1 text-sm text-slate-600 leading-snug">{p.role}</p>
    </div>
  </article>
);

const Connector: React.FC = () => (
