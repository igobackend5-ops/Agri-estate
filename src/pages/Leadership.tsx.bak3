import React, { useEffect, useState } from 'react';
import { X } from 'lucide-react';
import SEO from '../components/SEO';
import { leadershipTiers, type Leader } from '../data/leadershipData';

type Person = Leader;

const IMG = '/images/leadership/';

const stats = [
  { value: '26+', label: 'Brands' },
  { value: '18+', label: 'Divisions' },
  { value: '2000+', label: 'Team Strength' },
  { value: '28', label: 'States' },
  { value: '700+', label: 'Districts' },
];

const Photo: React.FC<{ p: Person; className?: string }> = ({ p, className = '' }) => (
  <div className={`overflow-hidden bg-[#eef5ea] ${className}`}>
    <img
      src={`${IMG}${p.img}`}
      alt={p.name}
      loading="lazy"
      className="w-full h-full object-cover object-top"
    />
  </div>
);

/* Standard grid card */
const Card: React.FC<{ p: Person; onOpen: (p: Person) => void }> = ({ p, onOpen }) => (
  <article role="button" tabIndex={0} onClick={() => onOpen(p)} onKeyDown={(e) => e.key === 'Enter' && onOpen(p)} className="cursor-pointer group relative flex flex-col bg-white rounded-2xl border border-[#1B5E20]/15 shadow-[0_4px_16px_rgba(15,45,30,0.06)] hover:shadow-[0_10px_28px_rgba(27,94,32,0.15)] hover:-translate-y-1 transition-all duration-300 overflow-hidden">
    <Photo p={p} className="aspect-[4/5]" />
    <div className="h-1 bg-gradient-to-r from-[#1B5E20] to-[#6bbf3a]" />
    <div className="p-4 text-center flex-1">
      <h3 className="text-base font-semibold text-[#0b2a1a] normal-case tracking-normal leading-snug">{p.name}</h3>
      <p className="mt-1.5 text-sm text-slate-600 leading-snug">{p.role}</p>
    </div>
  </article>
);

/* Prominent Founder / CEO card */
const FounderCard: React.FC<{ p: Person; onOpen: (p: Person) => void }> = ({ p, onOpen }) => (
  <article role="button" tabIndex={0} onClick={() => onOpen(p)} onKeyDown={(e) => e.key === 'Enter' && onOpen(p)} className="cursor-pointer relative w-full max-w-3xl mx-auto rounded-3xl bg-gradient-to-br from-[#1B5E20] via-[#14501a] to-[#0b2a1a] p-[3px] shadow-[0_20px_50px_rgba(27,94,32,0.3)]">
    <div className="grid md:grid-cols-[minmax(0,280px)_1fr] bg-white rounded-[21px] overflow-hidden">
      <Photo p={p} className="aspect-square md:aspect-auto md:h-full min-h-[260px]" />
      <div className="p-8 md:p-10 flex flex-col justify-center text-center md:text-left">
        <span className="self-center md:self-start inline-block px-3 py-1 rounded-full bg-[#eaf4e6] text-[#1B5E20] text-xs font-semibold uppercase tracking-[0.12em]">
          IGO Group
        </span>
        <h3 className="mt-4 text-2xl md:text-4xl font-bold text-[#0b2a1a] normal-case tracking-normal leading-tight">{p.name}</h3>
        <p className="mt-2 text-lg md:text-xl font-medium text-[#1B5E20]">{p.role}</p>
      </div>
    </div>
  </article>
);

/* Directors card (second level of importance) */
const DirectorCard: React.FC<{ p: Person; onOpen: (p: Person) => void }> = ({ p, onOpen }) => (
  <article role="button" tabIndex={0} onClick={() => onOpen(p)} onKeyDown={(e) => e.key === 'Enter' && onOpen(p)} className="cursor-pointer w-full max-w-sm mx-auto bg-white rounded-3xl border-2 border-[#1B5E20]/30 shadow-[0_12px_32px_rgba(27,94,32,0.14)] overflow-hidden">
    <Photo p={p} className="aspect-[4/5]" />
    <div className="h-1.5 bg-gradient-to-r from-[#1B5E20] to-[#6bbf3a]" />
    <div className="p-5 text-center">
      <h3 className="text-xl font-semibold text-[#0b2a1a] normal-case tracking-normal leading-snug">{p.name}</h3>
      <p className="mt-1.5 text-base text-[#1B5E20] font-medium">{p.role}</p>
    </div>
  </article>
);

/* Connector between tiers (vertical line with a node) */
const Connector: React.FC = () => (
  <div className="flex flex-col items-center" aria-hidden="true">
    <span className="block w-px h-8 md:h-12 bg-[#1B5E20]/40" />
    <span className="block w-3 h-3 rounded-full bg-[#1B5E20] ring-4 ring-[#1B5E20]/15" />
    <span className="block w-px h-8 md:h-12 bg-[#1B5E20]/40" />
  </div>
);

const TierHeading: React.FC<{ label: string; title: string }> = ({ label, title }) => (
  <div className="text-center mb-8 md:mb-10">
    <p className="text-xs font-semibold uppercase tracking-[0.2em] text-[#2e9e1f]">{label}</p>
    <h3 className="mt-1 text-lg md:text-2xl font-bold text-[#0b2a1a] normal-case tracking-normal">{title}</h3>
    <span className="mt-3 inline-block h-0.5 w-14 bg-[#1B5E20] rounded-full" />
  </div>
);


const Modal: React.FC<{ p: Person | null; onClose: () => void }> = ({ p, onClose }) => {
  useEffect(() => {
    if (!p) return;
    const h = (e: KeyboardEvent) => e.key === 'Escape' && onClose();
    document.addEventListener('keydown', h);
    document.body.style.overflow = 'hidden';
    return () => { document.removeEventListener('keydown', h); document.body.style.overflow = ''; };
  }, [p, onClose]);
  if (!p) return null;
  return (
    <div className="fixed inset-0 z-[100] bg-black/60 flex items-start md:items-center justify-center p-0 md:p-6 overflow-y-auto" onClick={onClose} role="dialog" aria-modal="true" aria-label={p.modalName}>
      <div className="relative bg-white w-full max-w-2xl md:rounded-3xl shadow-2xl my-0 md:my-8" onClick={(e) => e.stopPropagation()}>
        <button onClick={onClose} aria-label="Close" className="absolute top-4 right-4 w-10 h-10 rounded-full bg-[#eaf4e6] text-[#1B5E20] flex items-center justify-center hover:bg-[#d7ebd0]"><X size={20} /></button>
        <div className="p-6 md:p-10 text-center border-b border-[#1B5E20]/10">
          <img src={`${IMG}${p.img}`} alt={p.modalName} className="w-32 h-32 md:w-36 md:h-36 rounded-full object-cover object-top mx-auto border-4 border-white shadow-[0_10px_30px_rgba(11,61,19,0.22)]" />
          <h3 className="mt-4 text-2xl md:text-3xl font-bold text-[#0b2a1a] normal-case tracking-normal">{p.modalName}</h3>
          <span className="mt-2 inline-block px-3 py-1 rounded-full bg-[#eaf4e6] text-[#1B5E20] text-sm font-semibold">{p.modalTitle}</span>
        </div>
        <div className="p-6 md:p-10">
          <p className="text-slate-700 leading-relaxed">{p.desc}</p>
          {p.bullets.length > 0 && (
            <ul className="mt-6 grid gap-3">
              {p.bullets.map((b, i) => {
                const k = b.indexOf(': ');
                return (
                  <li key={i} className="rounded-xl bg-[#f6faf1] border border-[#1B5E20]/10 p-4 text-sm leading-relaxed text-slate-600">
                    {k > 0 && k < 48 ? <><strong className="block text-[#1B5E20]">{b.slice(0, k)}</strong>{b.slice(k + 2)}</> : b}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </div>
    </div>
  );
};

const Leadership: React.FC = () => {
  const [active, setActive] = useState<Person | null>(null);
  const [t1, t2, t3, t4, t5] = leadershipTiers;
  const close = () => setActive(null);
  return (
  <main className="bg-white overflow-x-hidden">
    <SEO
      title="Leadership"
      description="Meet the leaders driving India's fastest-growing farming ecosystem — from executive vision to department excellence."
      canonical="/leadership"
      ogImage="https://www.igoagriestate.com/images/leadership/leadership-core-managers.webp"
    />

    {/* Hero — full-width team photo with text on a dark scrim (as in the reference) */}
    <section className="relative overflow-hidden pt-[112px] md:pt-[136px] bg-[#04140a]">
      <div className="relative">
        <img src={`${IMG}leadership-core-managers.webp`} alt="IGO Group Leadership Team" className="w-full h-auto block" />
        <div className="absolute top-0 inset-x-0 z-[2] pb-12 md:pb-16 px-4 text-center bg-gradient-to-b from-[#04140a]/95 via-[#04140a]/90 to-transparent">
          <div className="max-w-3xl mx-auto pt-6 md:pt-12">
            <span className="text-xs md:text-sm font-semibold uppercase tracking-[0.2em] text-[#8fe05a]">OUR LEADERSHIP</span>
            <h1 className="mt-3 text-[1.7rem] md:text-5xl font-bold text-white normal-case tracking-normal drop-shadow-lg">The Minds Behind IGO</h1>
            <p className="mt-3 text-[0.92rem] md:text-lg text-white/90 leading-relaxed">
              Meet the leaders driving India's fastest-growing farming ecosystem — from executive vision to department excellence.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Hierarchy chart */}
    <section className="py-16 md:py-24 bg-white">
      <div className="container-pro">
        <div className="text-center mb-12 md:mb-16">
          <p className="text-sm font-semibold uppercase tracking-[0.2em] text-[#2e9e1f]">Hierarchy Chart</p>
          <h2 className="mt-2 text-3xl md:text-5xl font-bold text-[#0b2a1a] normal-case tracking-normal">IGO Group of Companies</h2>
        </div>

        <TierHeading label={t1.label} title={t1.title} />
        <FounderCard p={t1.rows[0][0]} onOpen={setActive} />

        <Connector />
        <TierHeading label={t2.label} title={t2.title} />
        <DirectorCard p={t2.rows[0][0]} onOpen={setActive} />

        <Connector />
        <TierHeading label={t3.label} title={t3.title} />
        <div className="rounded-3xl bg-[#f6faf1] border border-[#1B5E20]/10 p-4 md:p-8 space-y-4 md:space-y-6">
          {t3.rows.map((r, i) => (
            <div key={i} className={`grid grid-cols-2 gap-4 md:gap-6 mx-auto ${r.length === 2 ? 'max-w-2xl' : 'lg:grid-cols-4 max-w-5xl'}`}>
              {r.map((p) => <Card key={p.name} p={p} onOpen={setActive} />)}
            </div>
          ))}
        </div>

        <Connector />
        <TierHeading label={t4.label} title={t4.title} />
        <div className="rounded-3xl bg-[#f6faf1] border border-[#1B5E20]/10 p-4 md:p-8 space-y-4 md:space-y-6">
          {t4.rows.map((r, i) => (
            <div key={i} className={`grid grid-cols-2 gap-4 md:gap-6 mx-auto ${r.length === 2 ? 'max-w-2xl' : 'lg:grid-cols-4'}`}>
              {r.map((p) => <Card key={p.name} p={p} onOpen={setActive} />)}
            </div>
          ))}
        </div>

        <Connector />
        <TierHeading label={t5.label} title={t5.title} />
        <div className="rounded-3xl bg-[#f6faf1] border border-[#1B5E20]/10 p-4 md:p-8">
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 max-w-5xl mx-auto">
            {t5.rows[0].map((p) => <Card key={p.name} p={p} onOpen={setActive} />)}
          </div>
        </div>
      </div>
    </section>

    {/* Statistics + head office */}
    <section className="bg-[#0b2a1a] py-14 md:py-16">
      <div className="container-pro text-center">
        <div className="grid grid-cols-2 md:grid-cols-5 gap-8">
          {stats.map((s) => (
            <div key={s.label}>
              <div className="text-4xl md:text-5xl font-bold text-[#8fe05a]">{s.value}</div>
              <div className="mt-1 text-sm uppercase tracking-[0.12em] text-white/80">{s.label}</div>
            </div>
          ))}
        </div>
        <p className="mt-10 text-lg text-white/90 max-w-3xl mx-auto">
          A diversified farming-tech conglomerate connecting farms, food, fintech and technology across India.
        </p>
        <div className="mt-8 inline-block rounded-2xl border border-white/15 bg-white/5 px-6 py-5 text-white/90">
          <p className="text-xs font-semibold uppercase tracking-[0.2em] text-[#8fe05a]">Head Office</p>
          <address className="mt-2 not-italic leading-relaxed">
            No. 17, Kovalan Street,<br />
            2nd Main Road, Uthandi Kanathur,<br />
            Chennai – 600119, India
          </address>
        </div>
      </div>
    </section>
    <Modal p={active} onClose={close} />
  </main>
  );
};

export default Leadership;
